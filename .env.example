# Build-time configuration for the hosted dashboard.
# Copy to `.env` for local development; Cloudflare Pages passes the same values
# through its build environment.
#
# Every VITE_* value is compiled into the client bundle and is therefore PUBLIC.
# Never place a secret in this file.

# Public Google OAuth client ID (Web application).
# Required for Google sign-in: when unset, the Google button is not rendered even
# if the backend advertises capabilities.auth.googleOAuth.
# The backend additionally needs GOOGLE_CLIENT_ID, and the dashboard origin must
# be registered as an authorized JavaScript origin for that client.
VITE_GOOGLE_CLIENT_ID=
